{% extends 'base.html' %}
{% load static %}

{% block title %}Clinician Dashboard | MedVision AI{% endblock %}

{% block content %}
<div class="container py-4">
    <!-- Top Welcome Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #0a1f38 0%, #163255 100%);">
        <div>
            <span class="badge bg-info text-dark mb-2 px-3 py-1 fw-bold">Clinical Workspace</span>
            <h2 class="fw-bold mb-1 text-white">Welcome, {{ user.first_name|default:user.username }}!</h2>
            <p class="text-light opacity-75 mb-0 small">
                Logged in as <strong class="text-white">{{ user.profile.role_title|default:"Healthcare Clinician" }}</strong> &bull; {{ user.profile.organization_or_hospital|default:"Affiliation Not Set" }}
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{% url 'fundus_camera' %}" class="btn btn-info text-dark shadow-sm fw-semibold">
                <i class="bi bi-camera-fill me-1"></i> Fundus Camera
            </a>
            <a href="{% url 'upload' %}" class="btn btn-medical-primary text-white shadow-sm">
                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload Scan
            </a>
            <a href="{% url 'history' %}" class="btn btn-medical-outline text-white">
                <i class="bi bi-clock-history me-1"></i> Scan History
            </a>
        </div>
    </div>

    <!-- Metric Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon blue">
                    <i class="bi bi-images"></i>
                </div>
                <div>
                    <div class="stat-value">{{ total_uploads }}</div>
                    <div class="stat-label">Total Scans Uploaded</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon teal">
                    <i class="bi bi-cpu-fill"></i>
                </div>
                <div>
                    <div class="stat-value">{{ completed_predictions }}</div>
                    <div class="stat-label">Analyses Completed</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon green">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <div class="stat-value">{{ normal_count }}</div>
                    <div class="stat-label">Grade 0 (No DR)</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon amber">
                    <i class="bi bi-exclamation-diamond-fill"></i>
                </div>
                <div>
                    <div class="stat-value">{{ dr_detected_count }}</div>
                    <div class="stat-label">DR Detected (Grade 1–4)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Predictions Table -->
        <div class="col-lg-8">
            <div class="card-medical p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-navy"><i class="bi bi-activity text-primary me-2"></i>Recent Retinal Scans</h5>
                    <a href="{% url 'history' %}" class="small text-primary text-decoration-none fw-semibold">View All History &rarr;</a>
                </div>

                {% if recent_predictions %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Scan</th>
                                <th>Source</th>
                                <th>Predicted Stage</th>
                                <th>Confidence</th>
                                <th>Uploaded Date</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in recent_predictions %}
                            <tr>
                                <td>
                                    <img src="{{ item.image.url }}" alt="Scan" class="rounded" style="width: 48px; height: 48px; object-fit: cover; border: 1px solid #cbd5e1;">
                                </td>
                                <td>
                                    {% if item.capture_source == 'CAMERA' %}
                                    <span class="badge bg-primary text-white"><i class="bi bi-camera me-1"></i>Camera</span>
                                    {% else %}
                                    <span class="badge bg-light text-dark border"><i class="bi bi-cloud-arrow-up me-1"></i>Upload</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge {{ item.badge_class }} px-2 py-1">
                                        {{ item.get_predicted_class_display }}
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">{{ item.confidence_percentage }}</div>
                                    <div class="confidence-meter mt-1" style="height: 6px; width: 80px;">
                                        <div class="confidence-bar" style="width: {{ item.confidence|floatformat:2 }}%;"></div>
                                    </div>
                                </td>
                                <td class="text-muted small">
                                    {{ item.created_at|date:"M d, Y" }}<br>
                                    <span class="text-secondary" style="font-size: 0.75rem;">{{ item.created_at|time:"H:i" }} UTC</span>
                                </td>
                                <td class="text-end">
                                    <a href="{% url 'result' item.pk %}" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-file-earmark-medical me-1"></i> Report
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="text-center py-5">
                    <div class="feature-icon-box mx-auto bg-light text-muted">
                        <i class="bi bi-camera"></i>
                    </div>
                    <h5 class="fw-bold text-dark mt-3">No Retinal Scans Yet</h5>
                    <p class="text-muted small mb-3">Upload your first retinal fundus photograph to initiate CNN deep learning inference.</p>
                    <a href="{% url 'upload' %}" class="btn btn-medical-primary">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload Retinal Image
                    </a>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Latest Result Spotlight / Quick Action -->
        <div class="col-lg-4">
            <div class="card-medical p-4 mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-stars text-warning me-2"></i>Latest Analysis Spotlight</h5>
                
                {% if latest_prediction %}
                <div class="text-center mb-3">
                    <div class="position-relative d-inline-block rounded overflow-hidden shadow-sm border">
                        <img src="{{ latest_prediction.image.url }}" alt="Latest Scan" style="width: 100%; max-height: 200px; object-fit: contain; background: #000;">
                        <span class="position-absolute top-0 end-0 m-2 badge {{ latest_prediction.badge_class }}">
                            {{ latest_prediction.predicted_class }}
                        </span>
                    </div>
                </div>
                <h6 class="fw-bold text-dark mb-1">{{ latest_prediction.get_predicted_class_display }}</h6>
                <div class="d-flex justify-content-between text-muted small mb-2">
                    <span>Confidence Score:</span>
                    <strong class="text-primary">{{ latest_prediction.confidence_percentage }}</strong>
                </div>
                <div class="confidence-meter mb-3">
                    <div class="confidence-bar" style="width: {{ latest_prediction.confidence_percentage }};"></div>
                </div>
                <p class="text-muted small mb-3" style="font-size: 0.82rem;">
                    {{ latest_prediction.human_description|truncatewords:20 }}
                </p>
                <div class="d-grid">
                    <a href="{% url 'result' latest_prediction.pk %}" class="btn btn-medical-navy btn-sm">
                        <i class="bi bi-eye-fill me-1"></i> View Full Clinical Report
                    </a>
                </div>
                {% else %}
                <div class="p-4 bg-light rounded text-center small text-muted">
                    <i class="bi bi-clipboard2-pulse fs-3 text-secondary d-block mb-2"></i>
                    No completed analysis records yet.
                </div>
                {% endif %}
            </div>

            <!-- Quick Guidelines -->
            <div class="card-medical p-4 bg-light border">
                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-lightbulb-fill text-warning me-1"></i> Image Capture Guidelines</h6>
                <ul class="text-muted small ps-3 mb-0" style="font-size: 0.8rem;">
                    <li class="mb-1">Ensure 45&deg; field-of-view color fundus photograph.</li>
                    <li class="mb-1">Optic disc and macula should be in sharp optical focus.</li>
                    <li class="mb-1">Supported file formats: JPG, JPEG, and PNG.</li>
                    <li>Files are processed locally and securely kept private.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}
