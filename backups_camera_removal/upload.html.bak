{% extends 'base.html' %}
{% load static %}

{% block title %}Analyze Retinal Fundus Scan | MedVision AI{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card-medical p-4 p-md-5 shadow-lg border-0">
                <div class="text-center mb-4">
                    <span class="badge bg-teal-subtle text-teal border px-3 py-1 mb-2 fw-semibold" style="color: #0d9488; background: #ccfbf1;">
                        <i class="bi bi-camera-fill me-1"></i> Retinal Image Analysis
                    </span>
                    <h2 class="fw-bold mb-1">Analyze Retinal Fundus Scan</h2>
                    <p class="text-muted small">Upload a fundus photograph for automated Diabetic Retinopathy screening</p>
                </div>

                <!-- Fundus Camera Banner Link -->
                <div class="p-3 mb-4 rounded-3 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 border" style="background: #f0fdfa; border-color: #99f6e4 !important;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-camera-fill fs-3 text-teal" style="color: #0d9488;"></i>
                        <div>
                            <h6 class="fw-bold mb-0 text-navy">Looking for Live Camera Capture?</h6>
                            <p class="small text-muted mb-0">Use our dedicated <strong>Fundus Camera Module</strong> with optical aperture reticles &amp; live validation.</p>
                        </div>
                    </div>
                    <a href="{% url 'fundus_camera' %}" class="btn btn-sm btn-info text-dark fw-semibold px-3 flex-shrink-0">
                        <i class="bi bi-camera-video me-1"></i> Open Fundus Camera
                    </a>
                </div>

                <form method="POST" action="{% url 'upload' %}" enctype="multipart/form-data" id="retinalUploadForm">
                    {% csrf_token %}

                    <!-- Drag & Drop Container -->
                    <div class="dropzone-container mb-3" id="retinalDropzone">
                        <i class="bi bi-cloud-arrow-up dropzone-icon"></i>
                        <h5 class="fw-bold mb-1">Drag and drop your retinal photograph here</h5>
                        <p class="text-muted small mb-3">or click anywhere in this area to browse from your computer</p>

                        <button type="button" class="btn btn-outline-primary btn-sm px-3 rounded-pill" onclick="document.getElementById('retinalImageInput').click();">
                            <i class="bi bi-folder2-open me-1"></i> Browse File
                        </button>

                        <div class="text-muted mt-3" style="font-size: 0.78rem;">
                            Supported formats: <strong>JPG, JPEG, PNG</strong> &bull; Max file size: <strong>15 MB</strong>
                        </div>

                        {{ form.image }}
                        {% if form.image.errors %}
                        <div class="alert alert-danger py-2 px-3 mt-3 mb-0 small text-start">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> {{ form.image.errors.0 }}
                        </div>
                        {% endif %}
                    </div>

                    <!-- Client-side Image Preview Box -->
                    <div class="preview-container text-center mb-4" id="imagePreviewContainer" style="display: none;">
                        <div class="position-relative d-inline-block rounded overflow-hidden border">
                            <img id="imagePreview" src="" alt="Retinal Preview" style="max-height: 280px; width: auto;">
                            <button type="button" id="clearImageBtn" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2 shadow-sm rounded-circle" style="width: 32px; height: 32px; padding: 0;">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <div class="mt-2 small text-muted">
                            <span id="previewFileName" class="fw-semibold text-dark"></span> &bull; 
                            <span id="previewFileSize"></span>
                        </div>
                    </div>

                    <!-- Optional Clinical Notes -->
                    <div class="mb-4">
                        <label for="{{ form.notes.id_for_label }}" class="form-label fw-semibold">
                            Clinical Notes / Patient Reference <span class="text-muted fw-normal small">(Optional)</span>
                        </label>
                        {{ form.notes }}
                        <small class="text-muted" style="font-size: 0.78rem;">
                            E.g., Patient Ref #1042, Right Eye (OD), Type 2 Diabetes duration 8 years.
                        </small>
                    </div>

                    <!-- Submission & Reset Buttons -->
                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                        <button type="reset" class="btn btn-outline-secondary px-3" id="resetBtn" onclick="document.getElementById('clearImageBtn')?.click();">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Form
                        </button>
                        <button type="submit" class="btn btn-medical-primary px-4 py-2" id="submitAnalyzeBtn" disabled>
                            <i class="bi bi-cpu-fill me-1"></i> Analyze Image
                        </button>
                    </div>
                </form>
            </div>

            <!-- Pre-flight Recommendations -->
            <div class="card-medical p-4 mt-4 bg-light border">
                <h6 class="fw-bold mb-2"><i class="bi bi-shield-check text-success me-2"></i>Quality Recommendations for Best Model Accuracy:</h6>
                <div class="row g-2 small text-muted">
                    <div class="col-md-6 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-success flex-shrink-0 mt-1"></i>
                        <span>Center the optic disc and fovea inside the 45&deg; field.</span>
                    </div>
                    <div class="col-md-6 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-success flex-shrink-0 mt-1"></i>
                        <span>Avoid severe flash flare, dust ring artifacts, or motion blur.</span>
                    </div>
                    <div class="col-md-6 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-success flex-shrink-0 mt-1"></i>
                        <span>Ordinary selfies and non-retinal photos will be automatically rejected.</span>
                    </div>
                    <div class="col-md-6 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-success flex-shrink-0 mt-1"></i>
                        <span>All processed images remain strictly private and protected.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
